import {initializeApp} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";import {getAuth,signInWithEmailAndPassword,onAuthStateChanged,signOut} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";import {getFirestore,collection,doc,setDoc,addDoc,updateDoc,deleteDoc,onSnapshot,getDocs} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";import {getFunctions,httpsCallable} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-functions.js";
const firebaseConfig={apiKey:"AIzaSyCvLtUCpKWhVeMh7QcbrlJZpvtAPAIplXo",authDomain:"ristorante-rossini.firebaseapp.com",projectId:"ristorante-rossini",storageBucket:"ristorante-rossini.firebasestorage.app",appId:"1:886098533105:web:6528ce9772520d02b4e750"};
const seed=[{id:"spaghetti-carbonara",category:"Pasta",name:"Spaghetti Carbonara",price:"€14",image:"https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?auto=format&fit=crop&w=900&q=80",description:"Guanciale, pecorino, uova e pepe nero.",descriptionEn:"Guanciale, pecorino cheese, eggs, and black pepper.",badge:"Chef's Choice",order:1},{id:"tagliatelle-al-tartufo",category:"Pasta",name:"Tagliatelle al Tartufo",price:"€19",image:"https://images.unsplash.com/photo-1555949258-eb67b1ef0ceb?auto=format&fit=crop&w=900&q=80",description:"Tagliatelle fresche con crema al tartufo.",descriptionEn:"Fresh tagliatelle with truffle cream.",badge:"Premium",order:2},{id:"risotto-ai-funghi",category:"Pasta",name:"Risotto ai Funghi",price:"€16",image:"https://images.unsplash.com/photo-1473093295043-cdd812d0e601?auto=format&fit=crop&w=900&q=80",description:"Riso Carnaroli, funghi porcini e parmigiano.",descriptionEn:"Carnaroli rice, porcini mushrooms, and parmesan.",badge:"Vegetarian",order:3},{id:"pizza-margherita",category:"Pizza",name:"Pizza Margherita",price:"€12",image:"https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=900&q=80",description:"Pomodoro, mozzarella e basilico fresco.",descriptionEn:"Tomato sauce, mozzarella, and fresh basil.",badge:"Classic",order:4},{id:"pizza-diavola",category:"Pizza",name:"Pizza Diavola",price:"€15",image:"https://images.unsplash.com/photo-1594007654729-407eedc4be65?auto=format&fit=crop&w=900&q=80",description:"Salame piccante, mozzarella e peperoncino.",descriptionEn:"Spicy salami, mozzarella, and chili flakes.",badge:"Spicy",order:5},{id:"quattro-formaggi",category:"Pizza",name:"Quattro Formaggi",price:"€17",image:"https://images.unsplash.com/photo-1574071318508-1cdbab80d002?auto=format&fit=crop&w=900&q=80",description:"Mozzarella, gorgonzola, fontina e parmigiano.",descriptionEn:"Mozzarella, gorgonzola, fontina, and parmesan.",badge:"Cheese Lover",order:6},{id:"tiramisu-della-casa",category:"Dolci",name:"Tiramisù della Casa",price:"€8",image:"https://images.unsplash.com/photo-1571877227200-a0d98ea607e9?auto=format&fit=crop&w=900&q=80",description:"Mascarpone, caffè e cacao.",descriptionEn:"Mascarpone, coffee, and cocoa.",badge:"Signature",order:7},{id:"panna-cotta",category:"Dolci",name:"Panna Cotta",price:"€7",image:"https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&fit=crop&w=900&q=80",description:"Vaniglia con salsa ai frutti di bosco.",descriptionEn:"Vanilla panna cotta with berry sauce.",badge:"Light",order:8},{id:"gelato-artigianale",category:"Dolci",name:"Gelato Artigianale",price:"€6",image:"https://images.unsplash.com/photo-1563805042-7684c019e1cb?auto=format&fit=crop&w=900&q=80",description:"Selezione di gusti italiani.",descriptionEn:"Selection of Italian flavors.",badge:"Artisan",order:9}];
const app=initializeApp(firebaseConfig),auth=getAuth(app),db=getFirestore(app),menuRef=collection(db,"menu"),functions=getFunctions(app,"us-central1"),translateMenuItem=httpsCallable(functions,"translateMenuItem");const $=id=>document.getElementById(id);const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));let categories=[],unsub=null;const isCategoryDoc=d=>d.data()?.type==="category";const categoryDocId=c=>"category_"+c.toLowerCase().trim().replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"");try{await signOut(auth)}catch(_){}
$('loginBtn').onclick=async()=>{ $('loginMsg').classList.add('hidden');try{await signInWithEmailAndPassword(auth,$('email').value.trim(),$('password').value)}catch(e){$('loginMsg').classList.remove('hidden');$('loginMsg').textContent=e.code==='auth/invalid-credential'?'Invalid email or password.':e.message}};$('logoutBtn').onclick=()=>signOut(auth);onAuthStateChanged(auth,user=>{$('loginCard').classList.toggle('hidden',!!user);$('app').classList.toggle('hidden',!user);if(user)start();else stop()});function stop(){if(unsub)unsub();unsub=null}
function start(){unsub=onSnapshot(menuRef,snap=>{const all=snap.docs;categories=[...new Set([...all.filter(isCategoryDoc).map(d=>d.data().name||''),...all.filter(d=>!isCategoryDoc(d)).map(d=>d.data().category||'')].filter(Boolean))].sort((a,b)=>a.localeCompare(b));renderCategoryOptions();renderCategories(all);renderItems(all.filter(d=>!isCategoryDoc(d)))},e=>{$('items').innerHTML='<div class="msg">'+esc(e.message)+'</div>'})}
function renderCategoryOptions(){const cur=$('newCategory').value;$('newCategory').innerHTML=categories.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');if(categories.includes(cur))$('newCategory').value=cur}
function renderCategories(all){const counts={};all.filter(d=>!isCategoryDoc(d)).forEach(d=>{const c=d.data().category;if(c)counts[c]=(counts[c]||0)+1});$('categoriesList').innerHTML=categories.length?categories.map(c=>`<div class="cat"><span>${esc(c)} <small>(${counts[c]||0})</small></span><button class="btn red delCat" data-cat="${esc(c)}">Delete</button></div>`).join(''):'<div class="note">No categories yet.</div>';document.querySelectorAll('.delCat').forEach(b=>b.onclick=async()=>{const c=b.dataset.cat,n=counts[c]||0;if(!confirm(n?`Delete ${c} and its ${n} menu items?`:`Delete ${c}?`))return;try{const snap=await getDocs(menuRef);for(const d of snap.docs){const x=d.data();if((isCategoryDoc(d)&&String(x.name).toLowerCase()===c.toLowerCase())||(!isCategoryDoc(d)&&String(x.category).toLowerCase()===c.toLowerCase()))await deleteDoc(doc(db,'menu',d.id))}}catch(e){alert(e.message)}})}
function fileToDataUrl(file,maxSide=1000,quality=.78){return new Promise((resolve,reject)=>{if(!file)return reject(new Error('Choose a photo first.'));if(!file.type.startsWith('image/'))return reject(new Error('Please choose an image.'));const r=new FileReader();r.onerror=()=>reject(new Error('Could not read image.'));r.onload=()=>{const img=new Image();img.onerror=()=>reject(new Error('Could not process image.'));img.onload=()=>{let w=img.naturalWidth,h=img.naturalHeight,s=Math.min(1,maxSide/Math.max(w,h));w=Math.round(w*s);h=Math.round(h*s);const c=document.createElement('canvas');c.width=w;c.height=h;c.getContext('2d').drawImage(img,0,0,w,h);resolve(c.toDataURL('image/jpeg',quality))};img.src=r.result};r.readAsDataURL(file)})}
const LANG_NAMES={it:"Italiano"};
const TARGET_LANGS=["it","en","de","es","pt","fr"];
function decodeHtml(s){const t=document.createElement("textarea");t.innerHTML=String(s??"");return t.value}
async function buildTranslations(x,sourceOverride){
  const sourceLanguage=sourceOverride&&sourceOverride!=="auto"?sourceOverride:"it";
  if(sourceLanguage!=="it") throw new Error("AI translation currently expects Italian source text. Choose Italiano or Auto-detect for Italian menu items.");
  const result=await translateMenuItem({source:{
    name:String(x.name||"").trim(),
    description:String(x.description||"").trim(),
    category:String(x.category||"").trim(),
    badge:String(x.badge||"").trim()
  }});
  const generated=result?.data?.translations;
  if(!generated) throw new Error("AI translation returned no translations.");
  const translations={...(x.translations||{})};
  for(const lang of TARGET_LANGS){
    const item=generated[lang]||{};
    translations[lang]={
      ...(translations[lang]||{}),
      name:String(item.name||""),
      description:String(item.description||""),
      category:String(item.category||x.category||""),
      badge:String(item.badge||"")
    };
  }
  translations.it={...(translations.it||{}),name:String(x.name||""),description:String(x.description||""),category:String(x.category||""),badge:String(x.badge||"")};
  return translations;
}
function renderItems(docs){
  docs.sort((a,b)=>(Number(a.data().order??999)-Number(b.data().order??999)));
  $('items').innerHTML=docs.length?'':'<div class="note">No menu items yet.</div>';
  docs.forEach(d=>{
    const x=d.data(),box=document.createElement('div');box.className='item';
    const translatedCount=TARGET_LANGS.filter(l=>x.translations?.[l]?.name).length;
    box.innerHTML=`<img src="${esc(x.image)}" alt="${esc(x.name)}" onerror="this.style.opacity='.2'"><div class="item-fields">
      <div class="grid2"><input class="name" value="${esc(x.name)}" placeholder="Dish name"><input class="price" value="${esc(x.price)}" placeholder="Price"></div>
      <select class="category">${categories.map(c=>`<option ${x.category===c?'selected':''}>${esc(c)}</option>`).join('')}</select>
      <input class="image" value="${esc(x.image)}" placeholder="Image URL">
      <div class="upload"><input class="imageFile" type="file" accept="image/*"><button type="button" class="btn light usePhoto">Use photo</button></div>
      <div class="grid2"><textarea class="desc" placeholder="Italian/source description">${esc(x.description)}</textarea><textarea class="descEn" placeholder="English description">${esc(x.descriptionEn||'')}</textarea></div>
      <input class="badge" value="${esc(x.badge||'')}" placeholder="Badge">
      <div class="grid2"><select class="sourceLang"><option value="auto">Auto-detect source</option>${Object.entries(LANG_NAMES).map(([k,v])=>`<option value="${k}">${v}</option>`).join('')}</select><button class="btn gold translateOne">Translate missing/all languages</button></div>
      <div class="muted translationStatus" style="margin-top:6px">${translatedCount}/6 languages have saved translations.</div>
      <div class="actions"><button class="btn save">Save changes</button><button class="btn red del">Delete</button></div>
    </div>`;
    box.querySelector('.save').onclick=async()=>{
      try{
        await updateDoc(doc(db,'menu',d.id),{
          category:box.querySelector('.category').value,name:box.querySelector('.name').value.trim(),price:box.querySelector('.price').value.trim(),image:box.querySelector('.image').value.trim(),
          description:box.querySelector('.desc').value.trim(),descriptionEn:box.querySelector('.descEn').value.trim(),badge:box.querySelector('.badge').value.trim(),order:x.order??999
        });
      }catch(e){alert(e.message)}
    };
    box.querySelector('.translateOne').onclick=async()=>{
      const btn=box.querySelector('.translateOne'),status=box.querySelector('.translationStatus');
      btn.disabled=true;btn.textContent='Translating…';
      try{
        const current={...x,name:box.querySelector('.name').value.trim(),description:box.querySelector('.desc').value.trim(),descriptionEn:box.querySelector('.descEn').value.trim(),badge:box.querySelector('.badge').value.trim()};
        const translations=await buildTranslations(current,box.querySelector('.sourceLang').value);
        await updateDoc(doc(db,'menu',d.id),{name:current.name,description:current.description,descriptionEn:current.descriptionEn,badge:current.badge,translations});
        status.textContent='6/6 languages translated and saved.';
      }catch(e){status.textContent='Translation failed: '+e.message}
      finally{btn.disabled=false;btn.textContent='Translate missing/all languages'}
    };
    box.querySelector('.usePhoto').onclick=async()=>{try{const data=await fileToDataUrl(box.querySelector('.imageFile').files[0]);box.querySelector('.image').value=data;box.querySelector('img').src=data}catch(e){alert(e.message)}};
    box.querySelector('.del').onclick=async()=>{if(confirm('Delete this menu item?'))try{await deleteDoc(doc(db,'menu',d.id))}catch(e){alert(e.message)}};
    $('items').appendChild(box)
  })
}
$('addCat').onclick=async()=>{const c=$('newCat').value.trim();if(!c)return alert('Enter a category name.');if(categories.some(x=>x.toLowerCase()===c.toLowerCase()))return alert('That category already exists.');try{await setDoc(doc(db,'menu',categoryDocId(c)),{type:'category',name:c});$('newCat').value=''}catch(e){alert(e.message)}};
$('newUploadBtn').onclick=async()=>{try{const data=await fileToDataUrl($('newImageFile').files[0]);$('newImage').value=data;$('newPreview').src=data;$('newPreview').classList.remove('hidden')}catch(e){alert(e.message)}};
async function addNewItem(withTranslation){
  const name=$('newName').value.trim();
  if(!name)return alert('Enter a dish name.');
  if(!$('newCategory').value)return alert('Create a category first.');
  const item={category:$('newCategory').value,name,price:$('newPrice').value.trim(),image:$('newImage').value.trim(),description:$('newDesc').value.trim(),descriptionEn:$('newDescEn').value.trim(),badge:$('newBadge').value.trim(),order:Date.now()};
  const msg=$('addMsg');msg.classList.remove('hidden');
  try{
    if(withTranslation){msg.textContent='Translating into all 6 languages…';item.translations=await buildTranslations(item,$('newSourceLang').value);}
    await addDoc(menuRef,item);
    msg.textContent=withTranslation?'Item added with 6-language translations.':'Item added successfully.';
    ['newName','newPrice','newImage','newDesc','newDescEn','newBadge'].forEach(id=>$(id).value='');
    $('newImageFile').value='';$('newPreview').classList.add('hidden');
  }catch(e){msg.textContent='Could not add item: '+e.message}
}
$('addBtn').onclick=()=>addNewItem(false);
$('addTranslateBtn').onclick=()=>addNewItem(true);

$('translateMissingBtn').onclick=async()=>{
  const btn=$('translateMissingBtn');btn.disabled=true;btn.textContent='Translating…';
  try{
    const snap=await getDocs(menuRef);let done=0,failed=0;
    for(const d of snap.docs){
      if(isCategoryDoc(d))continue;
      const x=d.data();const missing=TARGET_LANGS.some(l=>!x.translations?.[l]?.name||!x.translations?.[l]?.description);
      if(!missing)continue;
      try{
        const translations=await buildTranslations(x,'auto');
        await updateDoc(doc(db,'menu',d.id),{translations});done++;
      }catch(_){failed++}
    }
    alert(`Translation finished. ${done} item(s) updated${failed?`; ${failed} failed`:'.'}`);
  }catch(e){alert(e.message)}
  finally{btn.disabled=false;btn.textContent='Translate missing languages'}
};
